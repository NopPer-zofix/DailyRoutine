# Copy to .env and fill in. Never commit .env.

# Token from @BotFather
BOT_TOKEN=123456:replace-me
# Your numeric chat id (message @userinfobot to find it). Only this chat can use the bot.
ADMIN_CHAT_ID=123456789

# --- Optional ---
# IANA timezone. Leave empty to use the Raspberry Pi's system timezone.
TIMEZONE=
# SQLite file (relative paths are relative to the project directory)
DB_PATH=data/routine.db

# Reminder checks fire every N hours between START and END (local hours, inclusive).
# 8 / 22 / 4  ->  08:00, 12:00, 16:00, 20:00
REMINDER_INTERVAL_HOURS=4
REMINDER_START_HOUR=8
REMINDER_END_HOUR=22

# reset = every task is copied to the new day as not-done (recurring routine)
# carry = only unfinished tasks are copied to the new day
ROLLOVER_MODE=reset
# One short "all done" message per day
SEND_CONGRATS=true
LOG_LEVEL=INFO
